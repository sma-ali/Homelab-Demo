#!/bin/sh
# Avant chaque commit : liste noire et règles génériques (fichiers + version indexée),
# e-mail d'auteur, puis gitleaks sur ce qui est indexé. Une seule correspondance bloque.
set -e
cd "$(git rev-parse --show-toplevel)"
python3 tools/check_leaks.py --staged
gitleaks protect --staged --redact --no-banner
